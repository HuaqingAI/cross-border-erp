# 复制本文件为 .env.prod 后再部署

# 你的 ERP 访问地址
# 示例：
# APP_ORIGIN=http://123.123.123.123
# APP_ORIGIN=https://erp.example.com
APP_ORIGIN=http://YOUR_SERVER_IP

# 如果服务器上已经有别的项目，建议先不要占用 80 / 9000 / 9001。
# 你可以先改成下面这样：
# NGINX_HOST_PORT=18080
# MINIO_API_HOST_PORT=19000
# MINIO_CONSOLE_HOST_PORT=19001
NGINX_HOST_PORT=80
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# MinIO 对外访问地址
# 当前版本文件上传依赖 MinIO 直传，所以浏览器必须能访问这个地址。
# 示例：
# MINIO_PUBLIC_ENDPOINT=http://123.123.123.123:${MINIO_API_HOST_PORT}
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

# 数据库与对象存储密码
# 建议只用大小写字母和数字，先不要用 $ 这类特殊字符，避免初次部署时转义出错。
MYSQL_ROOT_PASSWORD=ChangeThisMysqlPassword123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeThisMinioPassword123

# JWT 密钥
SECRET_KEY=ChangeThisToALongRandomSecretKey

# Cookie 配置
# 如果你现在先用服务器 IP 跑通，请保持 false。
# 如果你已经配好了 HTTPS，再改成 true。
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 对象存储桶
MINIO_BUCKET=erp-files
MINIO_SKU_IMAGE_BUCKET=erp-sku-images

# 首次部署时自动创建管理员账号
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin123456
